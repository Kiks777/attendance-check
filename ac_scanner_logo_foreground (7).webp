<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:ignore="HardcodedText">

    <RelativeLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
>

        <TextView
            android:id="@+id/student_IDNumber"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:text="2022300000"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/status_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/student_IDNumber"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            android:text="In"
            android:textColor="@color/black"
            android:layout_marginStart="35dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current_time_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/status_in"
            android:layout_marginStart="20dp"
            android:layout_marginTop="0dp"
            android:layout_toEndOf="@+id/student_IDNumber"
            android:text="current time"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/status_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/student_IDNumber"
            android:layout_marginTop="5dp"
            android:textSize="12sp"
            android:text="Out"
            android:textColor="@color/black"
            android:layout_marginStart="145dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current_time_out"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/status_out"
            android:layout_marginStart="135dp"
            android:layout_marginTop="0dp"
            android:layout_toEndOf="@+id/student_IDNumber"
            android:text="current time"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/line"
        android:layout_width="345dp"
        android:layout_height="1dp"
        android:layout_below="@+id/container"
        android:layout_marginTop="1dp"
        android:layout_centerHorizontal="true"
        android:background="@color/gray"
        android:orientation="horizontal">

    </LinearLayout>

</RelativeLayout>
